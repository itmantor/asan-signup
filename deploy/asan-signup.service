[Unit]
Description=Asan signup site (signup.asanfsp.ir)
After=network.target

[Service]
Type=simple
User=asan
Group=asan
WorkingDirectory=/opt/asan-signup
ExecStart=/usr/bin/node server/index.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/asan-signup/data

[Install]
WantedBy=multi-user.target
