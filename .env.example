# Copy this file to .env on the server and fill in the values:
#   cp .env.example .env
# .env is never committed to git.

# Where the server listens (Nginx forwards signup.asanfsp.ir to this address)
PORT=3100
HOST=127.0.0.1

# Long random text used to sign login cookies and hash codes. Generate with:
#   openssl rand -hex 32
APP_SECRET=

# "true" behind Nginx with HTTPS (cookies only over HTTPS, real visitor IP for limits)
COOKIE_SECURE=true
TRUST_PROXY=true
SESSION_DAYS=7

# ── SMS (login code) ──
# "parsgreen" for real SMS, "console" to print codes in the log (testing)
SMS_PROVIDER=console
# Same key as the healthcare project (/opt/asan/.env)
PARSGREEN_API_KEY=
# false = do not append the panel's brand name to the SMS
PARSGREEN_ADD_NAME=false
# Parsgreen only answers Iranian IPs. Same tunnel as the healthcare project, e.g. 127.0.0.1:9102
PARSGREEN_TUNNEL=

OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_IP_SENDS_PER_HOUR=10
OTP_MOBILE_SENDS_PER_DAY=8

# ── Pre-invoice ──
VAT_PERCENT=10

# ── Seller details (shown on the pre-invoice, footer and contact page) ──
# Empty fields are simply hidden.
SELLER_NAME="پلتفرم خدمات مالی آسان"
SELLER_NATIONAL_ID=
SELLER_ECONOMIC_CODE=
SELLER_REGISTRATION_NO=
SELLER_ADDRESS=
SELLER_POSTAL_CODE=
SELLER_PHONE=
SELLER_EMAIL=
SUPPORT_HOURS="شنبه تا چهارشنبه، ساعت ۹ تا ۱۷"

# Enamad trust-seal snippet (one line, exactly as Enamad gives it). Empty = no seal.
ENAMAD_HTML=

# Where users and pre-invoices are stored
DATA_FILE=data/db.json
